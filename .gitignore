# ==========================================
# Cheap Yellow Display Community - .gitignore
# ==========================================

# ---------- Private / Internal Files ----------
MASTER_INSTRUCTIONS.md
cyd_community_master_plan.md

# ---------- Arduino IDE ----------
*.elf
*.hex
*.bin
!flasher/binaries/*.bin
!flasher/binaries/**/*.bin
*.map
*.eep
build/
*.d

# ---------- PlatformIO ----------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ---------- ESP-IDF ----------
sdkconfig.old
build/
managed_components/

# ---------- VSCode ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- OS Files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- IDE ----------
*.swp
*.swo
*~
.idea/
*.iml
*.sublime-workspace
*.sublime-project

# ---------- Python (for scripts) ----------
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/

# ---------- Node (for web-flasher) ----------
node_modules/
npm-debug.log
yarn-error.log
.next/
dist/

# ---------- Compiled firmware ----------
# We track pre-compiled .bin files in web-flasher/firmware/
# but ignore local build outputs
*.o
*.obj
*.lst

# ---------- Secrets ----------
secrets.h
config.h
credentials.h
wifi_credentials.h


#custom
MASTER_INSTRUCTIONS.md
.MASTER_INSTRUCTIONS.md

# ---------- Elecrow Projects (Staged Hardware Verification) ----------
# Untested projects are kept private/ignored until individually verified on hardware
elecrow_projects/*
!elecrow_projects/README.md
!elecrow_projects/03-homelab-wol-deck/
!elecrow_projects/03-homelab-wol-deck/**
!elecrow_projects/04-usb-pc-telemetry-deck/
!elecrow_projects/04-usb-pc-telemetry-deck/**
!elecrow_projects/12-metar-weather-decoder/
!elecrow_projects/12-metar-weather-decoder/**
elecrow_projects/*/.pio/
elecrow_projects/*/.vscode/
